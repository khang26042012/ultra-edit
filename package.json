{
  "name": "ultra-edit",
  "version": "1.0.0",
  "description": "All-in-one programmatic video editing & motion graphics studio powered by HyperFrames, Remotion, React Three Fiber, Three.js, GSAP, Motion, and Lottie",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts UltraShowcase out/ultra-showcase.mp4",
    "remotion:render:type": "remotion render src/remotion/index.ts MotionTypography out/motion-typography.mp4",
    "remotion:upgrade": "remotion upgrade",
    "hyperframes:preview": "npx hyperframes preview src/hyperframes/intro",
    "hyperframes:render": "npx hyperframes render src/hyperframes/intro -o out/hyperframes-intro.mp4",
    "hyperframes:doctor": "npx hyperframes doctor",
    "typecheck": "tsc --noEmit",
    "skills:install": "npx skills add heygen-com/hyperframes && npx skills add remotion-dev/skills"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hyperframes/core": "^0.9.94",
    "@hyperframes/player": "^0.9.94",
    "@hyperframes/sdk": "^0.9.94",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.0.4",
    "@remotion/captions": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/google-fonts": "4.0.547",
    "@remotion/lottie": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "@remotion/player": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@remotion/shapes": "4.0.547",
    "@remotion/three": "4.0.547",
    "@remotion/transitions": "4.0.547",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.1",
    "hyperframes": "^0.9.94",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.511.0",
    "motion": "^14.14.0",
    "postprocessing": "^6.37.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.547",
    "three": "^0.187.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
